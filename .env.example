# Wspólne (dokumentacja)
NODE_ENV=development

# API (apps/api/.env)
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://moja_kuchnia:moja_kuchnia_dev@localhost:5432/moja_kuchnia
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-dev-only-not-for-production-use-32
AUTH_TRUSTED_ORIGINS=http://localhost:3000
ALLOW_DEMO_SEED=false

# Zdjęcia produktów i przepisów (S3 kompatybilne, np. Railway).
# Puste = moduł zdjęć wyłączony; API startuje, upload zwraca kontrolowany błąd.
# MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_MAX_UPLOAD_BYTES=10485760

# Web (apps/web/.env.local) — tylko serwer, nie NEXT_PUBLIC
API_ORIGIN=http://localhost:3001

# Mobile (apps/mobile/.env)
# iOS simulator / Expo web: http://localhost:3001
# Android emulator: http://10.0.2.2:3001
# Fizyczne urządzenie: http://<LAN-IP>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
