NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://moja_kuchnia:moja_kuchnia_dev@localhost:5432/moja_kuchnia
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-dev-only-not-for-production-use-32
AUTH_TRUSTED_ORIGINS=http://localhost:3000,mojakuchnia://,mojakuchnia://*
# W development Better Auth dodaje też exp:// automatycznie w create-auth.
# Mobile woła API bezpośrednio (EXPO_PUBLIC_API_URL) — CORS dla natywnego
# fetch często nie ma Origin; credentials: omit + nagłówek Cookie.
ALLOW_DEMO_SEED=false

# Zdjęcia (S3-compatible, produkcja: Cloudflare R2). Puste = wyłączone;
# API startuje, upload zwraca kontrolowany błąd. Nie commituj sekretów.
# MEDIA_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_BUCKET=przepisy-jacka-media
MEDIA_STORAGE_DRIVER=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_MAX_UPLOAD_BYTES=10485760

# Open Food Facts — tylko publiczne GET po EAN (User-Agent wymagany przez OFF).
# OPEN_FOOD_FACTS_DRIVER=http
# OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=MojaKuchnia/0.1 (https://github.com/JacekMizura/Przepisy-Jacka)
OPEN_FOOD_FACTS_TIMEOUT_MS=8000
OPEN_FOOD_FACTS_CACHE_TTL_SECONDS=86400
