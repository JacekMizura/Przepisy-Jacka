      },
      "delete": {
        "operationId": "StockController_deleteStock",
        "parameters": [
          {
            "name": "kitchenId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stockItemId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
