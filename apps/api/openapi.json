  },
  "info": {
    "title": "Moja Kuchnia API",
    "description": "REST API aplikacji Moja Kuchnia",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-24T21:54:00.000Z"
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "emailVerified",
          "image",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Jacek",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "KitchenSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "CreateKitchenDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Dom Jacka",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "KitchenMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "email",
          "name",
          "role",
          "joinedAt"
        ]
      },
      "KitchenDetailsDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KitchenMemberDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "members"
        ]
      },
      "KitchenInviteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "member"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expiresAt",
          "acceptedAt",
          "revokedAt"
        ]
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "InviteCreatedDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "inviteUrl": {
            "type": "string",
            "description": "Jednorazowy link z surowym tokenem. Token nie jest ponownie zwracany."
          }
        },
        "required": [
          "id",
          "email",
          "expiresAt",
          "inviteUrl"
        ]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kitchenId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "normalizedName": {
            "type": "string"
          },
          "defaultUnit": {
            "type": "string",
            "enum": [
              "piece",
              "gram",
              "milliliter"
            ]
          },
          "ean": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kitchenId",
          "name",
          "normalizedName",
          "defaultUnit",
          "ean",
          "imageUrl",
          "category",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Mleko"
          },
          "defaultUnit": {
            "type": "string",
            "enum": [
              "piece",
              "gram",
              "milliliter"
            ],
            "example": "milliliter"
          },
          "ean": {
            "type": "string",
            "nullable": true,
            "example": "5901234123457",
            "description": "Kod EAN/GTIN (8, 12, 13 lub 14 cyfr)."
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "URL http(s) albo data URL obrazu (jpeg/png/webp/gif)."
          },
          "category": {
            "type": "string",
            "nullable": true,
            "example": "Nabiał"
          }
        },
        "required": [
          "name",
          "defaultUnit"
        ]
      },
      "StockItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "initialQuantity": {
            "type": "string",
            "example": "500.000"
          },
          "quantity": {
            "type": "string",
            "example": "500.000"
          },
          "location": {
            "type": "string",
            "enum": [
              "pantry",
              "fridge",
              "freezer",
              "other"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "purchasedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "purchasePriceMinor": {
            "type": "number",
            "example": 599
          },
          "currency": {
            "type": "string",
            "example": "PLN"
          },
          "ean": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "productId",
          "initialQuantity",
          "quantity",
          "location",
          "expiresAt",
          "purchasedAt",
          "purchasePriceMinor",
          "currency",
          "ean",
          "imageUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateStockItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "example": "500.000",
            "description": "Początkowa i bieżąca ilość jako decimal string (max 3 miejsca)."
          },
          "location": {
            "type": "string",
            "enum": [
              "pantry",
              "fridge",
              "freezer",
              "other"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "purchasedAt": {
            "type": "string",
            "format": "date-time"
          },
          "purchasePriceMinor": {
            "type": "number",
            "example": 599,
            "description": "Łączna cena zakupu początkowej partii w groszach."
          },
          "currency": {
            "type": "string",
            "example": "PLN"
          },
          "ean": {
            "type": "string",
