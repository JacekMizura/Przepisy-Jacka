    "/api/kitchens/{kitchenId}/products/{productId}": {
      "delete": {
        "operationId": "StockController_deleteProduct",
        "parameters": [
          {
            "name": "kitchenId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "productId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "confirmCascade",
            "required": false,
            "in": "query",
