        ]
      }
    },
    "/api/kitchens/{kitchenId}/stock-items": {
      "get": {
        "operationId": "StockController_listStock",
        "parameters": [
          {
            "name": "kitchenId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "productId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "pantry",
                "fridge",
                "freezer",
                "other"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
