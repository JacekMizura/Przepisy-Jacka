generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  createdKitchens Kitchen[] @relation("KitchenCreator")
  memberships   KitchenMember[]
  createdInvites KitchenInvite[] @relation("InviteCreator")
  createdPurchases Purchase[]
  stockConsumptions StockConsumption[]
  authoredRecipes Recipe[] @relation("RecipeAuthor")
  recipeGapAdditions RecipeGapAddition[]
  mediaAssets   MediaAsset[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

enum KitchenRole {
  owner
  member
}

enum ProductUnit {
  piece
  gram
  milliliter
}

enum ProductPurchaseMode {
  unconfigured
  packaged
  exact
}

enum StorageLocation {
  pantry
  fridge
  freezer
  other
}

enum ShoppingListItemStatus {
  pending
  bought
  skipped
}

enum ShoppingInputUnit {
  piece
  gram
  kilogram
  milliliter
  liter
}

enum RecipeVisibility {
  private
  kitchen
}

enum RecipeDifficulty {
  easy
  medium
  hard
}

enum RecipeIngredientUnit {
  piece
  gram
  kilogram
  milliliter
  liter
  teaspoon
  tablespoon
  cup
  pinch
  package
  to_taste
}

enum MediaPurpose {
  product
  recipe_cover
  recipe_step
  purchase_receipt
}

enum MediaUploadStatus {
  pending
  processing
  ready
  failed
}

enum NutritionDataSource {
  manual
  open_food_facts
  usda_fdc
}

model Kitchen {
  id              String          @id @default(uuid())
  name            String
  createdByUserId String
  createdBy       User            @relation("KitchenCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  members         KitchenMember[]
  invites         KitchenInvite[]
  products        Product[]
  shoppingList    ShoppingList?
  purchases       Purchase[]
  stockConsumptions StockConsumption[]
  recipes         Recipe[]
  recipeCategories RecipeCategory[]
  mediaAssets     MediaAsset[]
}

model MediaAsset {
  id                 String            @id @default(uuid())
  kitchenId          String
  uploadedByUserId   String
  purpose            MediaPurpose
  objectKey          String
  thumbnailObjectKey String?
  mimeType           String            @db.VarChar(100)
  byteSize           Int
  width              Int?
  height             Int?
  status             MediaUploadStatus @default(pending)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  kitchen            Kitchen           @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  uploadedBy         User              @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  product            Product?
  recipeCover        Recipe?
  recipeStep         RecipeStep?
  purchaseReceipt    Purchase?

  @@index([kitchenId, purpose])
  @@index([kitchenId, status])
  @@index([uploadedByUserId])
}

model KitchenMember {
  kitchenId String
  userId    String
  role      KitchenRole
  joinedAt  DateTime    @default(now())
  kitchen   Kitchen     @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kitchenId, userId])
  @@index([userId])
}

model KitchenInvite {
  id              String       @id @default(uuid())
  kitchenId       String
  email           String
  role            KitchenRole  @default(member)
  tokenHash       String       @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdBy       User         @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())
  kitchen         Kitchen      @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@index([kitchenId, email])
}

model Product {
  id             String              @id @default(uuid())
  kitchenId      String
  name           String
  normalizedName String
  defaultUnit    ProductUnit
  purchaseMode   ProductPurchaseMode @default(unconfigured)
  ean            String?             @db.VarChar(14)
  /// Zdjęcie zapasowe (http lub data URL). Nowe zdjęcia trafiają do imageMedia.
  imageUrl       String?
  imageMediaId   String?             @unique
  category       String?             @db.VarChar(80)
  /// Soft-delete: produkt znika z aktywnego katalogu, historia i partie zostają.
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  kitchen            Kitchen             @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  imageMedia         MediaAsset?         @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  nutrition          ProductNutrition?
  stockItems         StockItem[]
  shoppingListItems  ShoppingListItem[]
  purchaseLineItems  PurchaseLineItem[]
  stockConsumptions  StockConsumption[]
  recipeIngredients  RecipeIngredient[]
  purchaseOptions    ProductPurchaseOption[]

  @@unique([kitchenId, normalizedName])
  @@unique([kitchenId, ean])
  @@index([kitchenId, category])
}

model ProductNutrition {
  productId            String              @id
  baseQuantity         Decimal             @db.Decimal(12, 3)
  baseUnit             ProductUnit
  kcal                 Decimal             @db.Decimal(12, 3)
  proteinGrams         Decimal             @db.Decimal(12, 3)
  carbsGrams           Decimal             @db.Decimal(12, 3)
  fatGrams             Decimal             @db.Decimal(12, 3)
  fiberGrams           Decimal?            @db.Decimal(12, 3)
  saltGrams            Decimal?            @db.Decimal(12, 3)
  source               NutritionDataSource @default(manual)
  sourceFetchedAt      DateTime?
  sourceLabel          String?             @db.VarChar(200)
  sourceBrand          String?             @db.VarChar(200)
  /// Id wpisu katalogu USDA w momencie zatwierdzenia (kopia wartości; katalog nie nadpisuje).
  sourceGenericFoodId  String?
  sourceFdcId          Int?
  /// Jawna masa części jadalnej 1 szt. (g), gdy baseUnit = piece.
  sourcePieceGrams     Decimal?            @db.Decimal(12, 3)
  updatedAt            DateTime            @updatedAt
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Wspólny, tylko-do-odczytu katalog żywności USDA (Foundation / SR Legacy).
model UsdaFoodCatalogEntry {
  id                    String   @id @default(uuid())
  fdcId                 Int      @unique
  polishName            String
  polishNameNormalized  String
  aliases               Json
  searchText            String
  descriptionOriginal   String
  variantLabel          String
  dataType              String   @db.VarChar(32)
  category              String?
  compositionMayVary    Boolean  @default(false)
  basisLabel            String   @default("100 g części jadalnej")
  sourceDataset         String
  sourceRelease         String
  sourceUrl             String
  catalogVersion        String
  importedAt            DateTime
  publicationDate       String?
  kcal                  Decimal  @db.Decimal(12, 3)
  proteinGrams          Decimal  @db.Decimal(12, 3)
  carbsGrams            Decimal  @db.Decimal(12, 3)
  fatGrams              Decimal  @db.Decimal(12, 3)
  fiberGrams            Decimal? @db.Decimal(12, 3)
  saltGrams             Decimal? @db.Decimal(12, 3)
  sodiumMg              Decimal? @db.Decimal(12, 3)
  energyField           String
  carbsMethod           String?
  carbsApproximate      Boolean  @default(false)
  mappingWarnings       Json?

  @@index([polishNameNormalized])
  @@index([searchText])
  @@index([catalogVersion])
}

/// Cache odpowiedzi Open Food Facts (tylko EAN + wynik publiczny; bez danych użytkownika).
model OpenFoodFactsCache {
  ean       String   @id @db.VarChar(14)
  status    String   @db.VarChar(32)
  payload   Json
  fetchedAt DateTime
  expiresAt DateTime

  @@index([expiresAt])
}

model ProductPurchaseOption {
  id              String      @id @default(uuid())
  productId       String
  name            String
  contentQuantity Decimal     @db.Decimal(12, 3)
  contentUnit     ProductUnit
  isDefault       Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  shoppingListItems ShoppingListItem[]

  @@index([productId, isActive])
}

model StockItem {
  id                 String          @id @default(uuid())
  productId          String
  initialQuantity    Decimal         @db.Decimal(12, 3)
  quantity           Decimal         @db.Decimal(12, 3)
  location           StorageLocation
  expiresAt          DateTime?
  purchasedAt        DateTime?
  /// Oryginalna cena całej partii w groszach; null = nieznana.
  purchasePriceMinor Int?
  currency           String          @default("PLN") @db.VarChar(3)
  ean                String?         @db.VarChar(14)
  imageUrl           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseLineItem   PurchaseLineItem?
  consumptionLines   StockConsumptionLine[]

  @@index([productId])
  @@index([location])
}

/// Zatwierdzone zużycie zapasu (może obejmować wiele partii).
model StockConsumption {
  id                    String                 @id @default(uuid())
  kitchenId             String
  productId             String
  idempotencyKey        String                 @unique
  /// Zwykłe zużycie albo odpis (ta sama transakcja / przydział partii).
  kind                  StockConsumptionKind   @default(consume)
  /// Wymagany dla write_off (po trimie); opcjonalny dla consume.
  reason                String?
  totalQuantity         Decimal                @db.Decimal(12, 3)
  totalCostMinor        Int?
  costComplete          Boolean                @default(false)
  previewFingerprint    String
  createdByUserId       String
  createdAt             DateTime               @default(now())
  /// Cofnięcie innego zużycia (dodaje ilości z powrotem).
  reversesConsumptionId String?                @unique
  kitchen               Kitchen                @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy             User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                 StockConsumptionLine[]
  reversedBy            StockConsumption?      @relation("ConsumptionReversal", fields: [reversesConsumptionId], references: [id], onDelete: SetNull)
  reversalOf            StockConsumption?      @relation("ConsumptionReversal")

  @@index([kitchenId, productId, createdAt])
}

enum StockConsumptionKind {
  consume
  write_off
}


model StockConsumptionLine {
  id             String           @id @default(uuid())
  consumptionId  String
  stockItemId    String
  quantity       Decimal          @db.Decimal(12, 3)
  costMinor      Int?
  consumption    StockConsumption @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  stockItem      StockItem        @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([consumptionId])
  @@index([stockItemId])
}

model ShoppingList {
  id        String             @id @default(uuid())
  kitchenId String             @unique
  items     ShoppingListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  kitchen   Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
}

model ShoppingListItem {
  id               String                 @id @default(uuid())
  shoppingListId   String
  productId        String?
  customName       String?
  plannedQuantity  Decimal?               @db.Decimal(12, 3)
  plannedUnit      ShoppingInputUnit?
  requiredQuantity Decimal?               @db.Decimal(12, 3)
  requiredUnit     ShoppingInputUnit?
  sourceRecipeId   String?
  sourceRecipeName String?
  purchaseOptionId String?
  packageCount     Int?
  note             String?
  status           ShoppingListItemStatus @default(pending)
  resolvedAt       DateTime?
  shoppingList     ShoppingList           @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product          Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchaseOption   ProductPurchaseOption? @relation(fields: [purchaseOptionId], references: [id], onDelete: SetNull)
  sourceRecipe     Recipe?                @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  purchaseLineItem PurchaseLineItem?

  @@index([shoppingListId, status])
  @@index([shoppingListId, productId])
  @@index([purchaseOptionId])
  @@index([sourceRecipeId])
}

model Purchase {
  id              String             @id @default(uuid())
  kitchenId       String
  storeName       String?
  purchasedAt     DateTime
  currency        String             @default("PLN") @db.VarChar(3)
  totalPriceMinor Int
  idempotencyKey  String             @unique
  createdByUserId String
  createdAt       DateTime           @default(now())
  receiptMediaId  String?            @unique
  kitchen         Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  createdBy       User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  receiptMedia    MediaAsset?        @relation(fields: [receiptMediaId], references: [id], onDelete: SetNull)
  items           PurchaseLineItem[]

  @@index([kitchenId, purchasedAt])
}

model PurchaseLineItem {
  id                  String          @id @default(uuid())
  purchaseId          String
  productId           String
  stockItemId         String?         @unique
  shoppingListItemId  String?         @unique
  quantity            Decimal         @db.Decimal(12, 3)
  priceMinor          Int
  location            StorageLocation
  expiresAt           DateTime?
  displayName         String?
  purchase            Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockItem           StockItem?      @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  shoppingListItem    ShoppingListItem? @relation(fields: [shoppingListItemId], references: [id], onDelete: SetNull)
}

model Recipe {
  id              String             @id @default(uuid())
  kitchenId       String
  authorUserId    String
  name            String
  description     String?
  servings        Int
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  difficulty      RecipeDifficulty
  tags            String[]           @default([])
  visibility      RecipeVisibility   @default(private)
  sourceUrl       String?
  sourceAuthor    String?
  importedAt      DateTime?
  importIdempotencyKey String?       @unique
  coverMediaId    String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  kitchen         Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  author          User               @relation("RecipeAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  coverMedia        MediaAsset?              @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  ingredientGroups  RecipeIngredientGroup[]
  ingredients       RecipeIngredient[]
  steps             RecipeStep[]
  gapAdditions      RecipeGapAddition[]
  shoppingListItems ShoppingListItem[]
  categoryLinks     RecipeCategoryAssignment[]

  @@index([kitchenId])
  @@index([kitchenId, authorUserId])
  @@index([kitchenId, visibility])
  @@index([kitchenId, sourceUrl])
}

model RecipeCategory {
  id             String                     @id @default(uuid())
  kitchenId      String
  name           String
  normalizedName String
  sortOrder      Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  kitchen        Kitchen                    @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  recipes        RecipeCategoryAssignment[]

  @@unique([kitchenId, normalizedName])
  @@index([kitchenId, sortOrder])
}

model RecipeCategoryAssignment {
  recipeId   String
  categoryId String
  recipe     Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category   RecipeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
  @@index([categoryId])
}

model RecipeIngredientGroup {
  id          String             @id @default(uuid())
  recipeId    String
  name        String
  sortOrder   Int
  recipe      Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([recipeId, sortOrder])
}

model RecipeIngredient {
  id        String                 @id @default(uuid())
  recipeId  String
  groupId   String?
  name      String
  quantity  Decimal?               @db.Decimal(12, 3)
  unit      RecipeIngredientUnit
  note      String?
  productId String?
  sortOrder Int
  recipe    Recipe                 @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  group     RecipeIngredientGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  product   Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId, sortOrder])
  @@index([groupId])
}

model RecipeStep {
  id              String      @id @default(uuid())
  recipeId        String
  title           String?
  instruction     String
  tip             String?
  durationMinutes Int?
  sortOrder       Int
  imageMediaId    String?     @unique
  recipe          Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  imageMedia      MediaAsset? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([recipeId, sortOrder])
}

model RecipeGapAddition {
  id              String   @id @default(uuid())
  recipeId        String
  idempotencyKey  String   @unique
  servings        Int
  createdByUserId String
  result          Json
  createdAt       DateTime @default(now())
  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([recipeId])
}
