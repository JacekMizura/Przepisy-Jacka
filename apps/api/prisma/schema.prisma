generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  createdKitchens Kitchen[] @relation("KitchenCreator")
  memberships   KitchenMember[]
  createdInvites KitchenInvite[] @relation("InviteCreator")
  createdPurchases Purchase[]
  authoredRecipes Recipe[] @relation("RecipeAuthor")
  recipeGapAdditions RecipeGapAddition[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

enum KitchenRole {
  owner
  member
}

enum ProductUnit {
  piece
  gram
  milliliter
}

enum StorageLocation {
  pantry
  fridge
  freezer
  other
}

enum ShoppingListItemStatus {
  pending
  bought
  skipped
}

enum ShoppingInputUnit {
  piece
  gram
  kilogram
  milliliter
  liter
}

enum RecipeVisibility {
  private
  kitchen
}

enum RecipeDifficulty {
  easy
  medium
  hard
}

enum RecipeIngredientUnit {
  piece
  gram
  kilogram
  milliliter
  liter
  teaspoon
  tablespoon
  cup
  pinch
  package
  to_taste
}

model Kitchen {
  id              String          @id @default(uuid())
  name            String
  createdByUserId String
  createdBy       User            @relation("KitchenCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  members         KitchenMember[]
  invites         KitchenInvite[]
  products        Product[]
  shoppingList    ShoppingList?
  purchases       Purchase[]
  recipes         Recipe[]
}

model KitchenMember {
  kitchenId String
  userId    String
  role      KitchenRole
  joinedAt  DateTime    @default(now())
  kitchen   Kitchen     @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kitchenId, userId])
  @@index([userId])
}

model KitchenInvite {
  id              String       @id @default(uuid())
  kitchenId       String
  email           String
  role            KitchenRole  @default(member)
  tokenHash       String       @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdBy       User         @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())
  kitchen         Kitchen      @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@index([kitchenId, email])
}

model Product {
  id             String      @id @default(uuid())
  kitchenId      String
  name           String
  normalizedName String
  defaultUnit    ProductUnit
  ean            String?     @db.VarChar(14)
  imageUrl       String?
  category       String?     @db.VarChar(80)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  kitchen            Kitchen             @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  stockItems         StockItem[]
  shoppingListItems  ShoppingListItem[]
  purchaseLineItems  PurchaseLineItem[]
  recipeIngredients  RecipeIngredient[]
  purchaseOptions    ProductPurchaseOption[]

  @@unique([kitchenId, normalizedName])
  @@unique([kitchenId, ean])
  @@index([kitchenId, category])
}

model ProductPurchaseOption {
  id              String      @id @default(uuid())
  productId       String
  name            String
  contentQuantity Decimal     @db.Decimal(12, 3)
  contentUnit     ProductUnit
  isDefault       Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  shoppingListItems ShoppingListItem[]

  @@index([productId, isActive])
}

model StockItem {
  id                 String          @id @default(uuid())
  productId          String
  initialQuantity    Decimal         @db.Decimal(12, 3)
  quantity           Decimal         @db.Decimal(12, 3)
  location           StorageLocation
  expiresAt          DateTime?
  purchasedAt        DateTime?
  purchasePriceMinor Int
  currency           String          @default("PLN") @db.VarChar(3)
  ean                String?         @db.VarChar(14)
  imageUrl           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseLineItem   PurchaseLineItem?

  @@index([productId])
  @@index([location])
}

model ShoppingList {
  id        String             @id @default(uuid())
  kitchenId String             @unique
  items     ShoppingListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  kitchen   Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
}

model ShoppingListItem {
  id               String                 @id @default(uuid())
  shoppingListId   String
  productId        String?
  customName       String?
  plannedQuantity  Decimal?               @db.Decimal(12, 3)
  plannedUnit      ShoppingInputUnit?
  requiredQuantity Decimal?               @db.Decimal(12, 3)
  requiredUnit     ShoppingInputUnit?
  sourceRecipeId   String?
  sourceRecipeName String?
  purchaseOptionId String?
  packageCount     Int?
  note             String?
  status           ShoppingListItemStatus @default(pending)
  resolvedAt       DateTime?
  shoppingList     ShoppingList           @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product          Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchaseOption   ProductPurchaseOption? @relation(fields: [purchaseOptionId], references: [id], onDelete: SetNull)
  sourceRecipe     Recipe?                @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  purchaseLineItem PurchaseLineItem?

  @@index([shoppingListId, status])
  @@index([shoppingListId, productId])
  @@index([purchaseOptionId])
  @@index([sourceRecipeId])
}

model Purchase {
  id              String             @id @default(uuid())
  kitchenId       String
  storeName       String?
  purchasedAt     DateTime
  currency        String             @default("PLN") @db.VarChar(3)
  totalPriceMinor Int
  idempotencyKey  String             @unique
  createdByUserId String
  createdAt       DateTime           @default(now())
  kitchen         Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  createdBy       User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items           PurchaseLineItem[]

  @@index([kitchenId, purchasedAt])
}

model PurchaseLineItem {
  id                  String          @id @default(uuid())
  purchaseId          String
  productId           String
  stockItemId         String?         @unique
  shoppingListItemId  String?         @unique
  quantity            Decimal         @db.Decimal(12, 3)
  priceMinor          Int
  location            StorageLocation
  expiresAt           DateTime?
  displayName         String?
  purchase            Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockItem           StockItem?      @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  shoppingListItem    ShoppingListItem? @relation(fields: [shoppingListItemId], references: [id], onDelete: SetNull)
}

model Recipe {
  id              String             @id @default(uuid())
  kitchenId       String
  authorUserId    String
  name            String
  description     String?
  servings        Int
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  difficulty      RecipeDifficulty
  tags            String[]           @default([])
  visibility      RecipeVisibility   @default(private)
  sourceUrl       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  kitchen         Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  author          User               @relation("RecipeAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  ingredients       RecipeIngredient[]
  steps             RecipeStep[]
  gapAdditions      RecipeGapAddition[]
  shoppingListItems ShoppingListItem[]

  @@index([kitchenId])
  @@index([kitchenId, authorUserId])
  @@index([kitchenId, visibility])
}

model RecipeIngredient {
  id        String               @id @default(uuid())
  recipeId  String
  name      String
  quantity  Decimal?             @db.Decimal(12, 3)
  unit      RecipeIngredientUnit
  note      String?
  productId String?
  sortOrder Int
  recipe    Recipe               @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId, sortOrder])
}

model RecipeStep {
  id              String  @id @default(uuid())
  recipeId        String
  title           String?
  instruction     String
  durationMinutes Int?
  sortOrder       Int
  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, sortOrder])
}

model RecipeGapAddition {
  id              String   @id @default(uuid())
  recipeId        String
  idempotencyKey  String   @unique
  servings        Int
  createdByUserId String
  result          Json
  createdAt       DateTime @default(now())
  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([recipeId])
}
