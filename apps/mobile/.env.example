# Publiczny origin REST API (NestJS). Bez sekretów w EXPO_PUBLIC_*.
# iOS simulator: http://localhost:3001
# Android emulator: http://10.0.2.2:3001
# Urządzenie fizyczne: http://<LAN-IP>:3001
# Produkcja (Railway): https://<twoje-api>.up.railway.app
#
# Po stronie API ustaw AUTH_TRUSTED_ORIGINS z dokładnym mojakuchnia://
# (scheme z app.json). Bez wildcardów i bez exp://.
EXPO_PUBLIC_API_URL=http://localhost:3001
