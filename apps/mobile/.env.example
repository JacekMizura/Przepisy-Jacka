# Publiczny origin REST API (NestJS). Bez sekretów w EXPO_PUBLIC_*.
# iOS simulator: http://localhost:3001
# Android emulator: http://10.0.2.2:3001
# Fizyczny telefon (ta sama sieć Wi‑Fi): http://<LAN-IPv4-PC>:3001
#   — wymaga API_HOST=0.0.0.0 oraz usesCleartextTraffic (już w app.json).
# HTTPS tunel (opcjonalnie, tylko po zgodzie): https://<tymczasowy-host>
#
# Po stronie lokalnego API (apps/api/.env), nie Railway:
#   AUTH_TRUSTED_ORIGINS=http://localhost:3000,mojakuchnia://
#   MEDIA_STORAGE_DRIVER=memory
#   DATABASE_URL=… lokalny Postgres Compose (nie produkcja)
EXPO_PUBLIC_API_URL=http://localhost:3001
