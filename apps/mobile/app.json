{
  "expo": {
    "name": "Moja Kuchnia",
    "slug": "moja-kuchnia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mojakuchnia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "pl.mojakuchnia.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Moja Kuchnia potrzebuje aparatu do zdjęć produktów i paragonów.",
        "NSPhotoLibraryUsageDescription": "Moja Kuchnia potrzebuje galerii do wyboru zdjęć produktów i paragonów."
      }
    },
    "android": {
      "package": "pl.mojakuchnia.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Moja Kuchnia potrzebuje galerii do zdjęć produktów i paragonów.",
          "cameraPermission": "Moja Kuchnia potrzebuje aparatu do zdjęć produktów i paragonów."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
