      },
      "android": {
        "buildType": "apk",
        "versionCode": 2
      }
    },
    "production": {
      "node": "24.13.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://przepisy-jacka-production-ae86.up.railway.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
